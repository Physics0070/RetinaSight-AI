# =====================================================================
# RetinaSight AI — Environment configuration (EXAMPLE)
# Copy to `.env` (repo root) or `backend/.env` and fill in real values.
# NEVER commit a real .env. All values here are placeholders.
# =====================================================================

# ---- Runtime ----
RS_ENV=development                     # development | staging | production
RS_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
RS_DEBUG=true

# ---- API server ----
# On Render, PORT is injected automatically — do not hardcode it.
RS_HOST=0.0.0.0
RS_PORT=8000
RS_API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (no trailing slash).
RS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database ----
# Dev default (SQLite, zero install). For Postgres use e.g.:
#   postgresql+psycopg://user:password@host:5432/retinasight
RS_DATABASE_URL=sqlite+pysqlite:///./var/retinasight_dev.sqlite3
RS_DB_ECHO=false

# ---- Auth / JWT ----
# Generate strong random secrets, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(64))"
RS_JWT_SECRET=change-me-access-secret
RS_JWT_REFRESH_SECRET=change-me-refresh-secret
RS_JWT_ALGORITHM=HS256
RS_ACCESS_TOKEN_TTL_MINUTES=15
RS_REFRESH_TOKEN_TTL_DAYS=14
RS_JWT_ISSUER=retinasight-ai

# ---- Security policy ----
RS_PASSWORD_MIN_LENGTH=12
RS_LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---- Public base URL ----
# Used to build signed image URLs when RS_STORAGE_PROVIDER=local.
# In production set this to the deployed API origin (no trailing slash).
RS_PUBLIC_BASE_URL=http://localhost:8000

# ---- Object storage (retinal images) ----
# provider: local (dev filesystem) | s3 (any S3-compatible: AWS, R2, MinIO, Backblaze)
# Retinal images are ALWAYS private; access is granted only via short-lived signed URLs.
RS_STORAGE_PROVIDER=local
RS_STORAGE_LOCAL_ROOT=./var/object-store
RS_STORAGE_SIGNED_URL_TTL_SECONDS=300
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
RS_STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
RS_STORAGE_MAX_IMAGE_BYTES=15000000
RS_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# --- S3 provider (only used when RS_STORAGE_PROVIDER=s3) ---
RS_S3_BUCKET=
RS_S3_REGION=
RS_S3_ENDPOINT_URL=                    # leave blank for AWS; set for R2/MinIO
RS_S3_ACCESS_KEY_ID=
RS_S3_SECRET_ACCESS_KEY=
RS_S3_USE_PATH_STYLE=true

# ---- ML / inference ----
# provider: development (honest numpy stub, NOT FOR CLINICAL USE) | onnx | torch
RS_MODEL_PROVIDER=development
RS_MODEL_DIR=./ml/models
RS_ACTIVE_MODEL_VERSION=dev-0.0.0
RS_INFERENCE_MODE=sync                 # sync | worker

# ---- Bootstrap admin (seed script only; dev) ----
# Must NOT use a reserved TLD (.local/.test/.example/.invalid) — those fail
# email validation and produce an admin account that can never sign in.
RS_SEED_ADMIN_EMAIL=admin@retinasight.ai
RS_SEED_ADMIN_PASSWORD=ChangeMe_Admin123!

# ---- Frontend (dashboard) build-time vars (Vite) ----
# Set in dashboard/.env — must be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:8000/api/v1
