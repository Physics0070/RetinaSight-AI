# --- ML artifacts ---
# Datasets are never committed: they are patient images and licence-bound.
ml/data/
# Training checkpoints are large and reproducible from the pipeline.
ml/models/**/*.pt
ml/models/**/*.pth
*.tflite
ml/*.log
# The servable model IS committed (16 MB) so the repo is runnable end-to-end.
# Everything else under models/ is a build artefact.
ml/models/*
!ml/models/dr-v1.onnx
!ml/models/dr-v1.json

# --- local tooling ---
mobile/.flutter-plugins-dependencies
mobile/pubspec.lock

