# NOTE ON PATTERNS
# A bare `name/` here matches a directory called `name` at ANY depth, not just
# at the repository root. That is how `storage/` — meant for a dev object store
# — silently excluded `backend/app/storage/`, the entire object-storage module,
# from the repository: a fresh clone could not import the backend at all.
# Anchor directory rules with a leading slash unless they genuinely need to
# match at every level. `backend/tests/test_repo_completeness.py` enforces this.

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
/secrets/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
/env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local databases / storage (dev only) ---
*.sqlite3
*.db
/var/

# --- Node / frontend ---
node_modules/
dashboard/dist/
dashboard/.vite/
*.local

# --- Flutter / Dart ---
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins*
mobile/.packages

# --- ML artifacts ---
# Datasets are never committed: they are patient images and licence-bound.
ml/data/
# Training checkpoints are large and reproducible from the pipeline.
ml/models/**/*.pt
ml/models/**/*.pth
*.tflite
ml/*.log
# The servable model IS committed (16 MB) so the repo is runnable end-to-end.
# Everything else under models/ is a build artefact.
#
# v2 is what serves. v1 is kept alongside it as a rollback artefact: it is a
# different architecture generation (224px, argmax decision) and having it
# present makes reverting a config change rather than a git surgery.
ml/models/*
!ml/models/dr-v1.onnx
!ml/models/dr-v1.json
!ml/models/dr-v2.onnx
!ml/models/dr-v2.json
!ml/models/456px-ordinal-summary.json

# --- local tooling ---
mobile/.flutter-plugins-dependencies
mobile/pubspec.lock

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
